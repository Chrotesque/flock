# The address of your PocketBase instance, as the browser reaches it.
PUBLIC_POCKETBASE_URL=http://<pocketbase-host>:8091

# Where `pnpm deploy` mirrors the build: the pb_public directory of that instance.
# FLOCK_DEPLOY_DEST=\\nas\appdata\pocketbase_flock\pb_public

# Where `pnpm deploy:worker` puts the worker bundle: the folder a worker runs
# from on another machine (a NAS container's), its .worker-config.json beside it.
# FLOCK_WORKER_DEST=\\nas\appdata\flock_worker
