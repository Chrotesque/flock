{
	"name": "flock",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"setup-pb": "node scripts/runpb.mjs setup-pb.mjs",
		"deploy": "node scripts/deploy.mjs",
		"deploy:dry": "node scripts/deploy.mjs --dry",
		"worker": "node worker/index.mjs",
		"worker:once": "node worker/index.mjs --once",
		"worker:dry": "node worker/index.mjs --dry",
		"worker:auth": "node worker/authorize.mjs",
		"worker:vidiq": "node worker/index.mjs --vidiq"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tslib": "^2.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"pocketbase": "^0.28.0"
	}
}
